{
    "manufacturer": "lckfb",
    "type": "lichuang-dev",
    "target": "esp32s3",
    "builds": [
        {
            "name": "lichuang-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"li wei si\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Livis\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=15",
                "CONFIG_LV_FONT_MONTSERRAT_48=y",
                "CONFIG_LV_FONT_MONTSERRAT_20=y",
                "CONFIG_LV_FONT_MONTSERRAT_32=y",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
                "CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
                "CONFIG_BT_NIMBLE_ROLE_CENTRAL=n",
                "CONFIG_BT_NIMBLE_ROLE_OBSERVER=n",
                "CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185",
                "CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=8"
            ]
        }
    ]
}
